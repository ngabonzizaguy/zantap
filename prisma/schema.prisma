generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  phoneNumber     String
  momoCode        String
  isActive        Boolean               @default(true)
  kitchenOpen     Boolean               @default(true)
  tagline         String?
  location        String?
  deliveryTime    String?
  rating          Float?
  businessCategory String?
  payoutMethod    PayoutMethod          @default(MERCHANT_CODE)
  logoUrl         String?
  coverImageUrl   String?
  description     String?
  ownerTokenHash  String?
  /// Ops-controlled KDS surface flags (ADR-0056). Defaults off.
  featureWhatsappNotify Boolean @default(false)
  featureStockTracking  Boolean @default(false)
  featureProfitInsights Boolean @default(false)
  menuItems       MenuItem[]
  inventoryItems  InventoryItem[]
  orders          Order[]
  drivers         Driver[]
  expenses        VendorExpense[]
  recoveryEvents  VendorRecoveryEvent[]
  operatorActions OperatorAction[]
  convertedProspects Prospect[]         @relation("ProspectConvertedVendor")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model VendorRecoveryEvent {
  id         String    @id @default(cuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  context    String?
  reviewedAt DateTime?
  reviewNote String?
  at         DateTime  @default(now())

  @@index([vendorId])
}

model OperatorAction {
  id         String   @id @default(cuid())
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  action     String
  detail     String?
  operatorId String   @default("platform")
  at         DateTime @default(now())

  @@index([vendorId])
  @@index([at])
}

model Lead {
  id                String                 @id @default(cuid())
  businessName      String
  businessType      String
  contactName       String
  phone             String
  area              String
  message           String?
  status            LeadStatus             @default(NEW)
  source            String?
  consentAt         DateTime
  createdAt         DateTime               @default(now())
  routingAssignment LeadRoutingAssignment?
  convertedProspects Prospect[]            @relation("ProspectConvertedLead")

  @@index([status, createdAt])
  @@index([createdAt])
}

model Prospect {
  id                 String                 @id @default(cuid())
  businessName       String
  contactName        String?
  phone              String?
  area               String?
  source             String?
  mapsUrl            String?
  instagramHandle    String?
  notes              String?
  status             ProspectStatus         @default(FOUND)
  nextFollowUpAt     DateTime?
  convertedVendorId  String?
  convertedVendor    Vendor?                @relation("ProspectConvertedVendor", fields: [convertedVendorId], references: [id], onDelete: SetNull)
  convertedLeadId    String?
  convertedLead      Lead?                  @relation("ProspectConvertedLead", fields: [convertedLeadId], references: [id], onDelete: SetNull)
  interactions       ProspectInteraction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status, nextFollowUpAt])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model ProspectInteraction {
  id         String          @id @default(cuid())
  prospectId String
  prospect   Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  at         DateTime        @default(now())
  channel    ProspectChannel
  note       String?

  @@index([prospectId, at])
}

model MarketingSiteSettings {
  id               String   @id
  publicPhone      String?
  publicEmail      String?
  socialX          String?
  socialTiktok     String?
  socialInstagram  String?
  socialFacebook   String?
  socialLinkedin   String?
  socialYoutube    String?
  socialWhatsapp   String?
  updatedAt        DateTime @updatedAt
}

/// Owner-editable word-for-word overrides for the marketing-site copy
/// (Ops → Settings → Languages). `key` is a dot path into MARKETING_COPY
/// (lib/marketing/copy.ts); `locale` ∈ en/rw/fr/sw. Missing rows fall back to
/// the in-repo baseline dictionaries, then English.
model SiteTranslation {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
  @@index([locale])
}

/// Privacy-minimal, first-party marketing funnel events. Deliberately excludes
/// IP addresses, contact details, form values and browser fingerprints.
model MarketingFunnelEvent {
  id           String   @id @default(cuid())
  sessionId    String
  event        String
  target       String?
  locale       String
  path         String
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
}

model VendorExpense {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amountRwf  Int
  category   String
  note       String?
  spentAt    DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([vendorId, spentAt])
}

model LeadRoutingSettings {
  id              String   @id
  lastRecipientId String?
  updatedAt       DateTime @updatedAt
}

model LeadRoutingRecipient {
  id          String                  @id @default(cuid())
  name        String
  phone       String                  @unique
  enabled     Boolean                 @default(true)
  archivedAt  DateTime?
  assignments LeadRoutingAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([enabled, archivedAt])
}

model LeadRoutingAssignment {
  id             String               @id @default(cuid())
  leadId         String               @unique
  lead           Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      LeadRoutingRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientName  String
  recipientPhone String
  assignedAt     DateTime             @default(now())

  @@index([recipientId, assignedAt])
}

model MenuItem {
  id          String      @id @default(cuid())
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceRwf    Int
  imageUrl    String?
  category    String      @default("General")
  isAvailable Boolean     @default(true)
  thumbFrom   String?
  thumbTo     String?
  /// Optional dish-level stock (ADR-0055). Null = unlimited / tracking off for this item.
  stockCount         Int?
  lowStockThreshold  Int?
  /// Optional cost to make (RWF) for Know Your Profit margins.
  costPriceRwf       Int?
  archivedAt  DateTime?
  images      MenuImage[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([vendorId])
  @@index([vendorId, archivedAt])
}

model MenuImage {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  url        String
  blobPath   String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model InventoryItem {
  id                String                @id @default(cuid())
  vendorId          String
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name              String
  quantity          Decimal               @db.Decimal(15, 3)
  unit              String
  lowStockThreshold Decimal               @db.Decimal(15, 3)
  category          InventoryCategory
  unitCostRwf       Int?
  note              String?
  archivedAt        DateTime?
  adjustments       InventoryAdjustment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([vendorId, archivedAt])
  @@index([vendorId, category, archivedAt])
}

model InventoryAdjustment {
  id              String                  @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  sequence        Int
  type            InventoryAdjustmentType
  quantity        Decimal                 @db.Decimal(15, 3)
  oldQuantity     Decimal                 @db.Decimal(15, 3)
  newQuantity     Decimal                 @db.Decimal(15, 3)
  note            String?
  createdAt       DateTime                @default(now())

  @@unique([inventoryItemId, sequence])
}

model Order {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  customerPhone  String
  deliverySector String
  landmark       String
  totalAmount    Int
  status         OrderStatus   @default(PENDING)
  kitchenStage   KitchenStage?
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  orderItems     OrderItem[]
  payment        Payment?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId, status])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  quantity      Int
  unitPriceRwf  Int
  notes         String?

  @@index([orderId])
}

model Driver {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  initials  String
  hue       String   @default("#F5945F")
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([vendorId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Int
  provider        PaymentProvider @default(MTN_MOMO)
  transactionRef  String        @unique
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum KitchenStage {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
}

enum PayoutMethod {
  MERCHANT_CODE
  PHONE
}

enum PaymentProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InventoryCategory {
  INGREDIENTS
  DRINKS
  PACKAGING
  CLEANING
  OTHER
}

enum InventoryAdjustmentType {
  RECEIVED
  USED
  WASTED
  CORRECTION
}

enum LeadStatus {
  NEW
  CONTACTED
  ONBOARDED
  CLOSED
}

enum ProspectStatus {
  FOUND
  CONTACTED
  IN_TALKS
  CONVERTED
  DECLINED
  UNREACHABLE
}

enum ProspectChannel {
  WHATSAPP
  PHONE
  INSTAGRAM
  GOOGLE_MAPS
  EMAIL
  IN_PERSON
  OTHER
}
