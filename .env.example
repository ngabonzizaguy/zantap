# Supabase / PostgreSQL. When set, the Store seam uses the Prisma adapter;
# otherwise it falls back to the in-memory adapter (local dev / CI without a DB).
DATABASE_URL="postgresql://postgres:password@localhost:5432/zantap?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/zantap?schema=public"

# Disposable Postgres database for the Prisma Store contract test. When set,
# `npm test` can run the #prisma contract suite against Prisma; when unset, that
# suite is skipped. Set SKIP_PRISMA_TESTS=0 to opt in (see below).
TEST_DATABASE_URL=""

# Skip remote Prisma contract tests (#prisma). Each run reseeds ~100× over the
# network — heavy egress on Supabase Free. Opt in: SKIP_PRISMA_TESTS=0 npm test
SKIP_PRISMA_TESTS=1

# Refuse `npm run db:seed` when DATABASE_URL targets remote Supabase (pooler).
# Contract tests use TEST_DATABASE_URL (direct 5432) instead. Opt in explicitly:
# SEED_ALLOW_REMOTE=1
SEED_ALLOW_REMOTE=

# MoMo checkout mode: simulate = sandbox STK + PIN (local default); manual = USSD dial + self-confirm (production default).
MOMO_MODE="simulate"

# Legacy candidate-#15 signup code. Self-serve onboarding is now gate-free
# (ADR-0022); provisionVendor no longer requires it. Still read by the not-yet
# -migrated /onboard page to decide whether to show the wizard (Issue 3 removes
# that gate). Leave set in prod during the migration.
PROVISION_SECRET=""

# Optional server-side kill-switch for self-serve provisioning (ADR-0022).
# Off by default. Set to 1/true/on to close public signup wholesale (abuse
# brake) until real auth (#12). This is NOT PROVISION_SECRET.
PROVISION_KILL_SWITCH=""

# NOTE: VENDOR_WRITE_SECRET is retired (ADR-0022). Guarded vendor writes now use
# a per-vendor owner token minted at provision and cached in the browser
# (keyed by slug, never typed) — no shared write secret env var.

# Vercel Blob read/write token for server-side menu image uploads.
# When unset, localhost dev stores uploads in memory and serves them at
# /api/local-blob/… (re-upload after restarting the dev server).
BLOB_READ_WRITE_TOKEN=""

# Optional public site origin for storefront/QR/share/WhatsApp links and onboarding
# display copy (e.g. https://zantap.ai). When unset, the app uses window.location.origin
# on the client so local dev and preview deployments keep working.
NEXT_PUBLIC_BASE_URL=""

# Operator console (ADR-0039): Control API key + Ops UI login secret.
# Set both in local dev to use /ops. OPERATOR_API_KEY is never sent to the browser.
OPERATOR_API_KEY=""
OPERATOR_UI_SECRET=""
# Optional when Ops runs on a separate deployment (future split).
ZANTAP_OPERATOR_API_URL=""
OPS_APP_URL=""
