generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  phoneNumber     String
  momoCode        String
  isActive        Boolean               @default(true)
  kitchenOpen     Boolean               @default(true)
  tagline         String?
  location        String?
  deliveryTime    String?
  rating          Float?
  businessCategory String?
  payoutMethod    PayoutMethod          @default(MERCHANT_CODE)
  logoUrl         String?
  coverImageUrl   String?
  description     String?
  ownerTokenHash  String?
  menuItems       MenuItem[]
  orders          Order[]
  drivers         Driver[]
  recoveryEvents  VendorRecoveryEvent[]
  operatorActions OperatorAction[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model VendorRecoveryEvent {
  id         String    @id @default(cuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  context    String?
  reviewedAt DateTime?
  reviewNote String?
  at         DateTime  @default(now())

  @@index([vendorId])
}

model OperatorAction {
  id         String   @id @default(cuid())
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  action     String
  detail     String?
  operatorId String   @default("platform")
  at         DateTime @default(now())

  @@index([vendorId])
  @@index([at])
}

model Lead {
  id           String     @id @default(cuid())
  businessName String
  businessType String
  contactName  String
  phone        String
  area         String
  message      String?
  status       LeadStatus @default(NEW)
  source       String?
  consentAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
}

model MenuItem {
  id          String      @id @default(cuid())
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priceRwf    Int
  imageUrl    String?
  category    String      @default("General")
  isAvailable Boolean     @default(true)
  thumbFrom   String?
  thumbTo     String?
  archivedAt  DateTime?
  images      MenuImage[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([vendorId])
  @@index([vendorId, archivedAt])
}

model MenuImage {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  url        String
  blobPath   String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model Order {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         Vendor        @relation(fields: [vendorId], references: [id])
  customerPhone  String
  deliverySector String
  landmark       String
  totalAmount    Int
  status         OrderStatus   @default(PENDING)
  kitchenStage   KitchenStage?
  driverId       String?
  driver         Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  paidAt         DateTime?
  orderItems     OrderItem[]
  payment        Payment?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([vendorId, status])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  quantity      Int
  unitPriceRwf  Int
  notes         String?

  @@index([orderId])
}

model Driver {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  initials  String
  hue       String   @default("#F5945F")
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([vendorId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Int
  provider        PaymentProvider @default(MTN_MOMO)
  transactionRef  String        @unique
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum KitchenStage {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
}

enum PayoutMethod {
  MERCHANT_CODE
  PHONE
}

enum PaymentProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  ONBOARDED
  CLOSED
}
