generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  phoneNumber           String
  momoCode              String
  isActive              Boolean               @default(true)
  kitchenOpen           Boolean               @default(true)
  tagline               String?
  location              String?
  deliveryTime          String?
  rating                Float?
  businessCategory      String?
  payoutMethod          PayoutMethod          @default(MERCHANT_CODE)
  logoUrl               String?
  coverImageUrl         String?
  description           String?
  ownerTokenHash        String?
  /// Ops-controlled KDS surface flags (ADR-0056). Defaults off.
  featureWhatsappNotify Boolean               @default(false)
  featureStockTracking  Boolean               @default(false)
  featureProfitInsights Boolean               @default(false)
  /// Candidate #26: automatic public restaurant updates default on.
  updatesEnabled        Boolean               @default(true)
  /// ADR-0096 Commission: when global master is on, this Vendor can still opt out.
  commissionEnabled     Boolean               @default(true)
  /// Optional override % (0–100). Null → use CommissionSettings.globalDefaultPercent.
  commissionPercent     Decimal?              @db.Decimal(5, 2)
  /// Optional KDS fee reminder (UI deferred; Ops flag only in Slice 3).
  feeReminderEnabled    Boolean               @default(false)
  updateBatches         VendorUpdateBatch[]
  menuItems             MenuItem[]
  inventoryItems        InventoryItem[]
  orders                Order[]
  drivers               Driver[]
  expenses              VendorExpense[]
  vendorPayouts         VendorPayout[]
  recoveryEvents        VendorRecoveryEvent[]
  operatorActions       OperatorAction[]
  menuIntakes           MenuIntake[]          @relation("MenuIntakeDestinationVendor")
  convertedProspects    Prospect[]            @relation("ProspectConvertedVendor")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

enum MenuIntakePath {
  SELF_BUILD
  ASSISTED
}

enum MenuIntakeStatus {
  SUBMITTED
  IN_REVIEW
  NEEDS_INFORMATION
  READY_TO_IMPORT
  IMPORTING
  IMPORTED
  CANCELLED
}

enum MenuIntakeRevisionSource {
  VENDOR
  OPERATOR
}

enum MenuIntakeAccessKind {
  BROWSER
  ONE_TIME
}

enum MenuIntakeQuestionStatus {
  UNANSWERED
  ANSWERED
  NEEDS_FOLLOW_UP
}

model MenuIntake {
  id                  String                 @id @default(cuid())
  reference           String                 @unique
  status              MenuIntakeStatus       @default(SUBMITTED)
  path                MenuIntakePath
  businessName        String
  contactName         String
  phone               String
  locale              String
  alreadyOnZantap     Boolean                @default(false)
  storefrontHint      String?
  destinationVendorId String?
  destinationVendor   Vendor?                @relation("MenuIntakeDestinationVendor", fields: [destinationVendorId], references: [id], onDelete: SetNull)
  currentRevision     Int                    @default(1)
  importedAt          DateTime?
  cancelledAt         DateTime?
  deletedAt           DateTime?
  revisions           MenuIntakeRevision[]
  accesses            MenuIntakeAccess[]
  attachments         MenuIntakeAttachment[]
  questions           MenuIntakeQuestion[]
  contactLogs         MenuIntakeContactLog[]
  importRuns          MenuIntakeImportRun[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([status, updatedAt])
  @@index([deletedAt, updatedAt])
  @@index([phone])
  @@index([destinationVendorId])
}

model MenuIntakeRevision {
  id          String                   @id @default(cuid())
  intakeId    String
  intake      MenuIntake               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  sequence    Int
  source      MenuIntakeRevisionSource
  content     Json
  attachments MenuIntakeAttachment[]
  questions   MenuIntakeQuestion[]
  createdAt   DateTime                 @default(now())

  @@unique([intakeId, sequence])
  @@index([intakeId, createdAt])
}

model MenuIntakeAccess {
  id           String               @id @default(cuid())
  intakeId     String
  intake       MenuIntake           @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  tokenHash    String               @unique
  kind         MenuIntakeAccessKind
  expiresAt    DateTime
  lastActiveAt DateTime             @default(now())
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime             @default(now())

  @@index([intakeId, expiresAt])
}

model MenuIntakeAttachment {
  id           String              @id @default(cuid())
  intakeId     String
  intake       MenuIntake          @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  revisionId   String?
  revision     MenuIntakeRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  kind         String
  dishClientId String?
  fileName     String
  mime         String
  byteLength   Int
  blobPath     String
  createdAt    DateTime            @default(now())

  @@index([intakeId, createdAt])
  @@index([revisionId])
}

model MenuIntakeQuestion {
  id             String                   @id @default(cuid())
  intakeId       String
  intake         MenuIntake               @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  revisionId     String?
  revision       MenuIntakeRevision?      @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  question       String
  status         MenuIntakeQuestionStatus @default(UNANSWERED)
  answer         String?
  answeredBy     String?
  answeredAt     DateTime?
  deliveryMethod String?
  createdAt      DateTime                 @default(now())

  @@index([intakeId, status, createdAt])
}

model MenuIntakeContactLog {
  id         String     @id @default(cuid())
  intakeId   String
  intake     MenuIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  kind       String
  message    String
  operatorId String
  method     String
  createdAt  DateTime   @default(now())

  @@index([intakeId, createdAt])
}

model MenuIntakeImportRun {
  id              String     @id @default(cuid())
  intakeId        String
  intake          MenuIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  idempotencyKey  String     @unique
  status          String
  destinationSlug String?
  results         Json?
  error           String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([status, startedAt])
}

enum VendorUpdateType {
  NEW_DISH
  DISH_IMAGE
  PRICE_CHANGE
  DISH_RESTORED
  PROFILE_CHANGE
}

model VendorUpdateBatch {
  id             String              @id @default(cuid())
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  revision       Int                 @default(1)
  publishedAt    DateTime            @default(now())
  expiresAt      DateTime
  openCount      Int                 @default(0)
  menuVisitCount Int                 @default(0)
  entries        VendorUpdateEntry[]

  @@index([vendorId, publishedAt])
  @@index([vendorId, expiresAt])
}

model VendorUpdateEntry {
  id              String            @id @default(cuid())
  batchId         String
  batch           VendorUpdateBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type            VendorUpdateType
  subjectId       String
  name            String
  imageUrl        String?
  oldPriceRwf     Int?
  currentPriceRwf Int?
  summary         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([batchId, type, subjectId])
  @@index([batchId])
}

model VendorRecoveryEvent {
  id         String    @id @default(cuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  context    String?
  reviewedAt DateTime?
  reviewNote String?
  at         DateTime  @default(now())

  @@index([vendorId])
}

model OperatorAction {
  id         String   @id @default(cuid())
  vendorId   String?
  vendor     Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  action     String
  detail     String?
  operatorId String   @default("platform")
  at         DateTime @default(now())

  @@index([vendorId])
  @@index([at])
}

model Lead {
  id                 String                 @id @default(cuid())
  businessName       String
  businessType       String
  contactName        String
  phone              String
  area               String
  message            String?
  status             LeadStatus             @default(NEW)
  source             String?
  consentAt          DateTime
  createdAt          DateTime               @default(now())
  routingAssignment  LeadRoutingAssignment?
  convertedProspects Prospect[]             @relation("ProspectConvertedLead")

  @@index([status, createdAt])
  @@index([createdAt])
}

model BriefingInterest {
  id           String               @id @default(cuid())
  grantId      String?
  grant        BriefingAccessGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  name         String
  contact      String
  interestType String
  message      String
  createdAt    DateTime             @default(now())

  @@index([createdAt])
}

model BriefingDraft {
  id        String   @id @default("default")
  content   Json
  updatedAt DateTime @updatedAt
}

model BriefingVersion {
  id          String                @id @default(cuid())
  number      Int                   @unique
  content     Json
  publishedAt DateTime              @default(now())
  grants      BriefingAccessGrant[]

  @@index([publishedAt])
}

model BriefingAccessGrant {
  id                String             @id @default(cuid())
  recipientLabel    String
  recipientEmail    String?
  shortCode         String             @unique
  secretLookup      String             @unique
  secretHash        String
  expiresAt         DateTime
  revokedAt         DateTime?
  sessionGeneration Int                @default(0)
  versionId         String
  version           BriefingVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  sessions          BriefingSession[]
  activities        BriefingActivity[]
  interests         BriefingInterest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([expiresAt, revokedAt])
  @@index([versionId])
}

model BriefingSession {
  id                 String              @id @default(cuid())
  grantId            String
  grant              BriefingAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  tokenHash          String              @unique
  generation         Int
  acknowledgedAt     DateTime?
  lastSeenAt         DateTime            @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  userAgent          String?
  networkFingerprint String?
  activities         BriefingActivity[]
  createdAt          DateTime            @default(now())

  @@index([grantId, revokedAt, lastSeenAt])
  @@index([expiresAt])
}

model BriefingActivity {
  id        String               @id @default(cuid())
  grantId   String?
  grant     BriefingAccessGrant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  sessionId String?
  session   BriefingSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type      String
  detail    Json?
  at        DateTime             @default(now())

  @@index([grantId, at])
  @@index([sessionId, at])
  @@index([type, at])
}

model Prospect {
  id                String                @id @default(cuid())
  businessName      String
  contactName       String?
  phone             String?
  area              String?
  source            String?
  mapsUrl           String?
  instagramHandle   String?
  notes             String?
  status            ProspectStatus        @default(FOUND)
  nextFollowUpAt    DateTime?
  convertedVendorId String?
  convertedVendor   Vendor?               @relation("ProspectConvertedVendor", fields: [convertedVendorId], references: [id], onDelete: SetNull)
  convertedLeadId   String?
  convertedLead     Lead?                 @relation("ProspectConvertedLead", fields: [convertedLeadId], references: [id], onDelete: SetNull)
  interactions      ProspectInteraction[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, nextFollowUpAt])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

model ProspectInteraction {
  id         String          @id @default(cuid())
  prospectId String
  prospect   Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  at         DateTime        @default(now())
  channel    ProspectChannel
  note       String?

  @@index([prospectId, at])
}

model MarketingSiteSettings {
  id                            String   @id
  publicPhone                   String?
  publicEmail                   String?
  socialX                       String?
  socialTiktok                  String?
  socialInstagram               String?
  socialFacebook                String?
  socialLinkedin                String?
  socialYoutube                 String?
  socialWhatsapp                String?
  showMenuIntakeLanguageChoices Boolean  @default(false)
  /// KDS interface language availability (Ops → Settings → KDS languages).
  /// English is always available and is the fallback, so it has no flag.
  showKdsLanguageSelector       Boolean  @default(true)
  kdsLanguageRw                 Boolean  @default(true)
  kdsLanguageFr                 Boolean  @default(true)
  kdsLanguageSw                 Boolean  @default(true)
  updatedAt                     DateTime @updatedAt
}

/// Singleton Ops Commission controls (ADR-0096). Row id is always "default".
model CommissionSettings {
  id                   String   @id
  /// Master kill: off → 0% everywhere regardless of per-Vendor flags.
  globalEnabled        Boolean  @default(false)
  /// Default % (0–100) when a Vendor has Commission on and no custom %.
  globalDefaultPercent Decimal  @default(0) @db.Decimal(5, 2)
  /// Smallest Customer cart (RWF) allowed at checkout.
  minimumOrderTotalRwf Int      @default(1000)
  updatedAt            DateTime @updatedAt
}

/// Owner-editable word-for-word overrides for the marketing-site copy
/// (Ops → Settings → Languages). `key` is a dot path into MARKETING_COPY
/// (lib/marketing/copy.ts); `locale` ∈ en/rw/fr/sw. Missing rows fall back to
/// the in-repo baseline dictionaries, then English.
model SiteTranslation {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
  @@index([locale])
}

/// Privacy-minimal, first-party marketing funnel events. Deliberately excludes
/// IP addresses, contact details, form values and browser fingerprints.
model MarketingFunnelEvent {
  id           String   @id @default(cuid())
  sessionId    String
  event        String
  target       String?
  locale       String
  path         String
  referrerHost String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@index([sessionId, createdAt])
}

model VendorExpense {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amountRwf Int
  category  String
  note      String?
  spentAt   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([vendorId, spentAt])
}

model LeadRoutingSettings {
  id              String   @id
  lastRecipientId String?
  updatedAt       DateTime @updatedAt
}

model LeadRoutingRecipient {
  id          String                  @id @default(cuid())
  name        String
  phone       String                  @unique
  enabled     Boolean                 @default(true)
  archivedAt  DateTime?
  assignments LeadRoutingAssignment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([enabled, archivedAt])
}

model LeadRoutingAssignment {
  id             String               @id @default(cuid())
  leadId         String               @unique
  lead           Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      LeadRoutingRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  recipientName  String
  recipientPhone String
  assignedAt     DateTime             @default(now())

  @@index([recipientId, assignedAt])
}

model MenuItem {
  id                String      @id @default(cuid())
  vendorId          String
  vendor            Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  priceRwf          Int
  /// Ordered [{id,label,priceRwf,isAvailable}] options; null = single price.
  sizeOptions       Json?
  /// Ordered item-specific add-on groups and choices.
  addOnGroups       Json?
  imageUrl          String?
  category          String      @default("General")
  isAvailable       Boolean     @default(true)
  thumbFrom         String?
  thumbTo           String?
  /// Optional dish-level stock (ADR-0055). Null = unlimited / tracking off for this item.
  stockCount        Int?
  lowStockThreshold Int?
  /// Optional cost to make (RWF) for Know Your Profit margins.
  costPriceRwf      Int?
  archivedAt        DateTime?
  images            MenuImage[]
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([vendorId])
  @@index([vendorId, archivedAt])
}

model MenuImage {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  url        String
  blobPath   String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([menuItemId])
}

model InventoryItem {
  id                String                @id @default(cuid())
  vendorId          String
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name              String
  quantity          Decimal               @db.Decimal(15, 3)
  unit              String
  lowStockThreshold Decimal               @db.Decimal(15, 3)
  category          InventoryCategory
  unitCostRwf       Int?
  note              String?
  archivedAt        DateTime?
  adjustments       InventoryAdjustment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([vendorId, archivedAt])
  @@index([vendorId, category, archivedAt])
}

model InventoryAdjustment {
  id              String                  @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  sequence        Int
  type            InventoryAdjustmentType
  quantity        Decimal                 @db.Decimal(15, 3)
  oldQuantity     Decimal                 @db.Decimal(15, 3)
  newQuantity     Decimal                 @db.Decimal(15, 3)
  note            String?
  createdAt       DateTime                @default(now())

  @@unique([inventoryItemId, sequence])
}

model Order {
  id                       String         @id @default(cuid())
  vendorId                 String
  vendor                   Vendor         @relation(fields: [vendorId], references: [id])
  customerPhone            String
  deliverySector           String
  landmark                 String
  totalAmount              Int
  status                   OrderStatus    @default(PENDING)
  kitchenStage             KitchenStage?
  driverId                 String?
  driver                   Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  paidAt                   DateTime?
  /// ADR-0096: frozen at first PAID. Null on legacy / unpaid Orders.
  commissionFeeRwf         Int?
  vendorPayoutAmountRwf    Int?
  commissionPercentApplied Decimal?       @db.Decimal(5, 2)
  orderItems               OrderItem[]
  payment                  Payment?
  vendorPayouts            VendorPayout[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([vendorId, status])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  quantity        Int
  unitPriceRwf    Int
  sizeOptionId    String?
  sizeLabel       String?
  notes           String?
  /// Immutable add-on group/choice labels and prices selected at checkout.
  addOnSelections Json?

  @@index([orderId])
}

model Driver {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  initials  String
  hue       String   @default("#F5945F")
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([vendorId])
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  provider       PaymentProvider @default(MTN_MOMO)
  transactionRef String          @unique
  status         PaymentStatus   @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

/// One MoMo Disbursement Transfer attempt per row (ADR-0096 Slice 2).
/// Collection stays on Payment; retries append new rows. Order stays PAID on FAIL.
model VendorPayout {
  id          String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount      Int
  /// MoMo X-Reference-Id for this Transfer attempt.
  referenceId String             @unique
  status      VendorPayoutStatus @default(PENDING)
  /// MSISDN | PARTY_CODE snapshot at attempt time.
  payeeType   String
  payeeId     String
  lastError   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([orderId, createdAt])
  @@index([vendorId, status])
  @@index([status])
}

enum OrderStatus {
  PENDING
  PAID
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum KitchenStage {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
}

enum PayoutMethod {
  MERCHANT_CODE
  PHONE
}

enum PaymentProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum VendorPayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InventoryCategory {
  INGREDIENTS
  DRINKS
  PACKAGING
  CLEANING
  OTHER
}

enum InventoryAdjustmentType {
  RECEIVED
  USED
  WASTED
  CORRECTION
}

enum LeadStatus {
  NEW
  CONTACTED
  ONBOARDED
  CLOSED
}

enum ProspectStatus {
  FOUND
  CONTACTED
  IN_TALKS
  CONVERTED
  DECLINED
  UNREACHABLE
}

enum ProspectChannel {
  WHATSAPP
  PHONE
  INSTAGRAM
  GOOGLE_MAPS
  EMAIL
  IN_PERSON
  OTHER
}
