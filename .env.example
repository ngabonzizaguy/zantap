# Supabase / PostgreSQL. When set, the Store seam uses the Prisma adapter;
# otherwise it falls back to the in-memory adapter (local dev / CI without a DB).
DATABASE_URL="postgresql://postgres:password@localhost:5432/zantap?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/zantap?schema=public"

# Disposable Postgres database for the Prisma Store contract test. When set,
# `npm test` pushes the schema and runs the full contract suite against Prisma;
# when unset, that suite is skipped.
TEST_DATABASE_URL=""

# MoMo sandbox (future)
MOMO_API_KEY=""
MOMO_ENV="sandbox"
